<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- The persisted enum baseline is embedded so the test reads exactly what was built. -->
    <EmbeddedResource Include="PersistedEnumValues.txt" />
    <EmbeddedResource Include="SeedExecutionContracts.json" LogicalName="IXApi.Tests.SeedExecutionContracts.json" />
    <EmbeddedResource Include="SeedMappedTables.json" LogicalName="IXApi.Tests.SeedMappedTables.json" />
    <!-- Read as text, to assert every enum member carries its value explicitly. -->
    <EmbeddedResource Include="..\src\Modules\Finance\Common\Enums\Enumeration.cs" LogicalName="IXApi.Tests.Enumeration.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\IXApi.csproj" />
    <ProjectReference Include="..\src\Shared\IAX.IXApi.Shared.csproj" />
    <ProjectReference Include="..\src\Infrastructure\IAX.IXApi.Infrastructure.csproj" />
    <ProjectReference Include="..\src\Modules\Identity\IAX.IXApi.Modules.Identity.csproj" />
    <ProjectReference Include="..\src\Modules\Organization\IAX.IXApi.Modules.Organization.csproj" />
    <ProjectReference Include="..\src\Modules\Workflow\IAX.IXApi.Modules.Workflow.csproj" />
    <ProjectReference Include="..\src\Modules\Finance\IAX.IXApi.Modules.Finance.csproj" />
    <ProjectReference Include="..\src\Modules\Communication\IAX.IXApi.Modules.Communication.csproj" />
    <ProjectReference Include="..\src\Modules\Administration\IAX.IXApi.Modules.Administration.csproj" />
  </ItemGroup>
</Project>
