<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IAX.IXApi.Infrastructure</RootNamespace>
    <AssemblyName>IAX.IXApi.Infrastructure</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\IAX.IXApi.Shared.csproj" />
    <ProjectReference Include="..\Modules\Identity\IAX.IXApi.Modules.Identity.csproj" />
    <ProjectReference Include="..\Modules\Administration\IAX.IXApi.Modules.Administration.csproj" />
    <ProjectReference Include="..\Modules\Organization\IAX.IXApi.Modules.Organization.csproj" />
    <ProjectReference Include="..\Modules\Finance\IAX.IXApi.Modules.Finance.csproj" />
  </ItemGroup>
  <!--
    Transitional build-recovery boundary: the migrated module sources still depend on
    Infrastructure while the central DbContext depends on their entity types. Compile
    them together until those cycles are replaced with module-owned contracts.
  -->
  <ItemGroup>
    <Compile Include="..\..\GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="..\Modules\**\*.cs"
             Exclude="..\Modules\Identity\**\*.cs;..\Modules\Administration\**\*.cs;..\Modules\Organization\**\*.cs;..\Modules\Finance\**\*.cs;..\Modules\**\bin\**\*.cs;..\Modules\**\obj\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
