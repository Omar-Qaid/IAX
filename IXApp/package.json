{
  "name": "ixapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json scripts docs/ARCHITECTURE-BOUNDARIES.md docs/app-shell.md src/app/routes/AppAccessDeniedState.tsx src/core/configuration/environment.ts src/shared/services/notificationStore.ts src/shared/components/lookups/LookupDialog.tsx src/shared/components/lookups/LookupField.tsx src/shared/components/page/UnsavedChangesGuard.tsx src/shared/hooks/useUnsavedChanges.ts src/modules/finance/accounts-receivable/pages/SalesOrderPage.tsx src/test/core/localization.test.ts src/test/modules/RepresentativePages.test.tsx src/test/shared/Lookup.test.tsx public/locales/en/translation.json public/locales/ar/translation.json",
    "format:check:all": "prettier --check .",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:encoding": "node scripts/audit-encoding.mjs",
    "audit:localization": "node scripts/audit-localization.mjs",
    "audit:unused": "node scripts/report-unused-exports.mjs",
    "audit:static": "npm run audit:architecture && npm run audit:encoding",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:list": "playwright test --list",
    "verify": "npm run format:check && npm run audit:static && npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.5.7",
    "@mui/icons-material": "^9.2.0",
    "@mui/lab": "^9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "stylis": "4.2.0",
    "stylis-plugin-rtl": "^2.1.1",
    "utif": "^3.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
