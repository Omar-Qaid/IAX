<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IAX.IXApi</RootNamespace>
    <AssemblyName>IAX.IXApi</AssemblyName>
    <UserSecretsId>IAX-IXApi-development</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Content Remove="Tests\**\*" />
    <Compile Remove="src\**\*.cs" />
    <Content Remove="src\**\*" />
    <None Include="src\**\*" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="Mapster" Version="7.4.0" />
    <PackageReference Include="Mapster.DependencyInjection" Version="1.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9"><PrivateAssets>all</PrivateAssets><IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets></PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    <PackageReference Include="OpenAI" Version="2.4.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.8.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src\Shared\IAX.IXApi.Shared.csproj" />
    <ProjectReference Include="src\Infrastructure\IAX.IXApi.Infrastructure.csproj" />
    <ProjectReference Include="src\Modules\Identity\IAX.IXApi.Modules.Identity.csproj" />
    <ProjectReference Include="src\Modules\Organization\IAX.IXApi.Modules.Organization.csproj" />
    <ProjectReference Include="src\Modules\Workflow\IAX.IXApi.Modules.Workflow.csproj" />
    <ProjectReference Include="src\Modules\Finance\IAX.IXApi.Modules.Finance.csproj" />
    <ProjectReference Include="src\Modules\Communication\IAX.IXApi.Modules.Communication.csproj" />
    <ProjectReference Include="src\Modules\Administration\IAX.IXApi.Modules.Administration.csproj" />
  </ItemGroup>
</Project>
